{
  "name": "finagent-mobile",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "FinAgent móvil: agente financiero que corre 100% en el teléfono (sin servidor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/make-assets.mjs",
    "eval": "tsx evals/cli.ts",
    "eval:smoke": "tsx evals/cli.ts --smoke",
    "eval:fake": "tsx evals/cli.ts --fake=bueno"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-static": "^1.58.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}